<Page x:Class="AquaPark.Views.AddAttractionSchedulePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:services="clr-namespace:AquaPark.Services"
      Title="AddAttractionSchedulePage">

    <Grid Background="#EAF7FB">
        <Border Width="430"
                Background="White"
                CornerRadius="18"
                Padding="35"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">

            <Border.Effect>
                <DropShadowEffect BlurRadius="18" ShadowDepth="0" Opacity="0.18"/>
            </Border.Effect>

            <StackPanel>
                <TextBlock Text="Добавление расписания"
                           FontSize="26"
                           FontWeight="Bold"
                           Foreground="#16697A"
                           HorizontalAlignment="Center"
                           Margin="0 0 0 25"/>

                <TextBlock Text="Аттракцион" FontSize="14" Margin="0 0 0 6"/>
                <ComboBox ItemsSource="{Binding Attractions}"
                          SelectedItem="{Binding SelectedAttraction}"
                          DisplayMemberPath="AttractionName"
                          Margin="0 0 0 14"/>

                <TextBlock Text="Дата работы" FontSize="14" Margin="0 0 0 6"/>
                <DatePicker SelectedDate="{Binding WorkDate}" Margin="0 0 0 14"/>

                <TextBlock Text="Время начала (ЧЧ:ММ)" FontSize="14" Margin="0 0 0 6"/>
                <TextBox Text="{Binding StartTimeText, UpdateSourceTrigger=PropertyChanged}"
                         services:InputMaskBehavior.TimeOnly="True"
                         MaxLength="5"
                         Margin="0 0 0 14"/>

                <TextBlock Text="Время окончания (ЧЧ:ММ)" FontSize="14" Margin="0 0 0 6"/>
                <TextBox Text="{Binding EndTimeText, UpdateSourceTrigger=PropertyChanged}"
                         services:InputMaskBehavior.TimeOnly="True"
                         MaxLength="5"
                         Margin="0 0 0 14"/>

                <TextBlock Text="Статус" FontSize="14" Margin="0 0 0 6"/>
                <ComboBox ItemsSource="{Binding Statuses}"
                          SelectedItem="{Binding SelectedStatus}"
                          Margin="0 0 0 20"/>

                <TextBlock Text="{Binding ErrorMessage}"
                           Foreground="Red"
                           FontSize="13"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           Margin="0 0 0 12"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button Content="Сохранить"
                            Style="{StaticResource MainButtonStyle}"
                            Width="130"
                            Command="{Binding SaveCommand}"/>

                    <Button Content="Отмена"
                            Style="{StaticResource MainButtonStyle}"
                            Width="130"
                            Background="#D62828"
                            Command="{Binding BackCommand}"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Page>
