<Page x:Class="AquaPark.Views.EditTicketPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="EditTicketPage">

    <Grid Background="#EAF7FB">

        <Border Width="430"
                Background="White"
                CornerRadius="18"
                Padding="35"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">

            <Border.Effect>
                <DropShadowEffect BlurRadius="18"
                                  ShadowDepth="0"
                                  Opacity="0.18"/>
            </Border.Effect>

            <StackPanel>

                <TextBlock Text="Изменение билета"
                           FontSize="26"
                           FontWeight="Bold"
                           Foreground="#16697A"
                           HorizontalAlignment="Center"
                           Margin="0 0 0 25"/>

                <TextBlock Text="Тип билета"
                           FontSize="14"
                           Margin="0 0 0 6"/>

                <ComboBox ItemsSource="{Binding TicketTypes}"
                          SelectedItem="{Binding SelectedTicketType}"
                          DisplayMemberPath="TicketName"
                          Height="38"
                          FontSize="14"
                          BorderBrush="#B8DDE8"
                          BorderThickness="1"
                          Margin="0 0 0 14"/>

                <TextBlock Text="Клиент"
                           FontSize="14"
                           Margin="0 0 0 6"/>

                <ComboBox ItemsSource="{Binding Clients}"
                          SelectedItem="{Binding SelectedClient}"
                          DisplayMemberPath="FullName"
                          Height="38"
                          FontSize="14"
                          BorderBrush="#B8DDE8"
                          BorderThickness="1"
                          Margin="0 0 0 14"/>

                <TextBlock Text="Дата посещения"
                           FontSize="14"
                           Margin="0 0 0 6"/>

                <DatePicker SelectedDate="{Binding VisitDate}"
                            Height="38"
                            FontSize="14"
                            BorderBrush="#B8DDE8"
                            BorderThickness="1"
                            Margin="0 0 0 14"/>

                <TextBlock Text="Статус"
                           FontSize="14"
                           Margin="0 0 0 6"/>

                <ComboBox ItemsSource="{Binding Statuses}"
                          SelectedItem="{Binding SelectedStatus}"
                          Height="38"
                          FontSize="14"
                          BorderBrush="#B8DDE8"
                          BorderThickness="1"
                          Margin="0 0 0 20"/>

                <TextBlock Text="{Binding ErrorMessage}"
                           Foreground="Red"
                           FontSize="13"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           Margin="0 0 0 12"/>

                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Center">

                    <Button Content="Сохранить"
                            Width="130"
                            Height="38"
                            Margin="0 0 10 0"
                            Background="#16697A"
                            Foreground="White"
                            BorderThickness="0"
                            Cursor="Hand"
                            Command="{Binding SaveCommand}"/>

                    <Button Content="Отмена"
                            Width="130"
                            Height="38"
                            Background="#D62828"
                            Foreground="White"
                            BorderThickness="0"
                            Cursor="Hand"
                            Command="{Binding BackCommand}"/>
                </StackPanel>

            </StackPanel>
        </Border>
    </Grid>
</Page>