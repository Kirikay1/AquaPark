<Page x:Class="AquaPark.Views.ActionLogsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="ActionLogsPage">

    <Grid Background="#EAF7FB" Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0 0 0 20">
            <TextBlock Text="Журнал действий"
                       FontSize="28"
                       FontWeight="Bold"
                       Foreground="#16697A"
                       DockPanel.Dock="Left"/>

            <Button Content="Назад"
                    Width="100"
                    Height="35"
                    Background="#16697A"
                    Foreground="White"
                    BorderThickness="0"
                    Cursor="Hand"
                    Command="{Binding BackCommand}"/>
        </DockPanel>

        <WrapPanel Grid.Row="1" Margin="0 0 0 15">
            <Button Content="Обновить" Width="110" Height="36" Margin="0 0 10 0"
                    Background="#16697A" Foreground="White" BorderThickness="0"
                    Cursor="Hand" Command="{Binding RefreshCommand}"/>

            <TextBlock Text="Поиск:" VerticalAlignment="Center" FontSize="14" Margin="20 0 0 0"/>
            <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Width="220" Margin="10 0 0 0"/>

            <TextBlock Text="С:" VerticalAlignment="Center" FontSize="14" Margin="15 0 0 0"/>
            <DatePicker SelectedDate="{Binding DateFrom}" Width="140" Margin="8 0 0 0"/>

            <TextBlock Text="По:" VerticalAlignment="Center" FontSize="14" Margin="15 0 0 0"/>
            <DatePicker SelectedDate="{Binding DateTo}" Width="140" Margin="8 0 0 0"/>

            <Button Content="Очистить" Width="110" Height="36" Margin="10 0 0 0"
                    Background="#16697A" Foreground="White" BorderThickness="0"
                    Cursor="Hand" Command="{Binding ClearSearchCommand}"/>
        </WrapPanel>

        <DataGrid Grid.Row="2" ItemsSource="{Binding Logs}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding ActionLogId}" Width="60"/>
                <DataGridTextColumn Header="Дата" Binding="{Binding ActionDate, StringFormat=dd.MM.yyyy HH:mm}" Width="150"/>
                <DataGridTextColumn Header="Пользователь" Binding="{Binding UserName}" Width="180"/>
                <DataGridTextColumn Header="Действие" Binding="{Binding ActionType}" Width="120"/>
                <DataGridTextColumn Header="Раздел" Binding="{Binding EntityName}" Width="140"/>
                <DataGridTextColumn Header="Запись" Binding="{Binding EntityId}" Width="80"/>
                <DataGridTextColumn Header="Детали" Binding="{Binding Details}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0 12 0 0">
            <Button Content="|&lt;" Width="45" Height="32" Margin="0 0 8 0" Command="{Binding FirstPageCommand}"/>
            <Button Content="&lt;" Width="45" Height="32" Margin="0 0 12 0" Command="{Binding PreviousPageCommand}"/>
            <TextBlock Text="{Binding PageInfo}" VerticalAlignment="Center" FontSize="14" Foreground="#333333"/>
            <Button Content="&gt;" Width="45" Height="32" Margin="12 0 8 0" Command="{Binding NextPageCommand}"/>
            <Button Content="&gt;|" Width="45" Height="32" Command="{Binding LastPageCommand}"/>
        </StackPanel>
    </Grid>
</Page>
