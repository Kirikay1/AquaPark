<Page x:Class="AquaPark.Views.AuthorizationPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:vm="clr-namespace:AquaPark.ViewModel"
      xmlns:local="clr-namespace:AquaPark.Views"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="AuthorizationPage">

    <Page.DataContext>
        <vm:AuthorizationViewModel/>
    </Page.DataContext>

    <Grid Background="#EAF7FB">
        <Border Width="380"
                MinHeight="360"
                Background="White"
                CornerRadius="18"
                Padding="35"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">

            <Border.Effect>
                <DropShadowEffect BlurRadius="18"
                                  ShadowDepth="0"
                                  Opacity="0.25"/>
            </Border.Effect>

            <StackPanel>

                <TextBlock Text="АРМ Аквапарка"
                           FontSize="26"
                           FontWeight="Bold"
                           Foreground="#16697A"
                           HorizontalAlignment="Center"
                           Margin="0 0 0 8"/>

                <TextBlock Text="Авторизация"
                           FontSize="20"
                           FontWeight="SemiBold"
                           Foreground="#333333"
                           HorizontalAlignment="Center"
                           Margin="0 0 0 30"/>

                <TextBlock Text="Логин"
                           FontSize="14"
                           Foreground="#333333"
                           Margin="0 0 0 6"/>

                <TextBox Text="{Binding Login, UpdateSourceTrigger=PropertyChanged}"
                         Height="38"
                         FontSize="14"
                         Padding="10 0"
                         VerticalContentAlignment="Center"
                         BorderBrush="#B8DDE8"
                         BorderThickness="1"
                         Margin="0 0 0 18"/>

                <TextBlock Text="Пароль"
                           FontSize="14"
                           Foreground="#333333"
                           Margin="0 0 0 6"/>

                <PasswordBox x:Name="PasswordBox"
                             Height="38"
                             FontSize="14"
                             Padding="10 0"
                             VerticalContentAlignment="Center"
                             BorderBrush="#B8DDE8"
                             BorderThickness="1"
                             Margin="0 0 0 24"/>

                <Button Content="Войти"
                        Height="42"
                        FontSize="15"
                        FontWeight="SemiBold"
                        Foreground="White"
                        Background="#16697A"
                        BorderThickness="0"
                        Cursor="Hand"
                        Command="{Binding LoginCommand}"
                        CommandParameter="{Binding ElementName=PasswordBox}"/>

                <TextBlock Text="{Binding ErrorMessage}"
                           Foreground="Red"
                           FontSize="13"
                           TextAlignment="Center"
                           Margin="0 18 0 0"
                           TextWrapping="Wrap"/>

            </StackPanel>
        </Border>
    </Grid>
</Page>
