<Page x:Class="AquaPark.Views.EditClientPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:services="clr-namespace:AquaPark.Services"
      Title="EditClientPage">

    <Grid Background="#EAF7FB">

        <Border Width="420"
                Background="White"
                CornerRadius="18"
                Padding="35"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">

            <Border.Effect>
                <DropShadowEffect BlurRadius="18"
                                  ShadowDepth="0"
                                  Opacity="0.18"/>
            </Border.Effect>

            <StackPanel>

                <TextBlock Text="Изменение клиента"
                           FontSize="26"
                           FontWeight="Bold"
                           Foreground="#16697A"
                           HorizontalAlignment="Center"
                           Margin="0 0 0 25"/>

                <TextBlock Text="ФИО"
                           FontSize="14"
                           Margin="0 0 0 6"/>

                <TextBox Text="{Binding FullName, UpdateSourceTrigger=PropertyChanged}"
                         Height="38"
                         FontSize="14"
                         Padding="10 0"
                         VerticalContentAlignment="Center"
                         BorderBrush="#B8DDE8"
                         BorderThickness="1"
                         Margin="0 0 0 14"/>

                <TextBlock Text="Дата рождения"
                           FontSize="14"
                           Margin="0 0 0 6"/>

                <DatePicker SelectedDate="{Binding BirthDate}"
                            Height="38"
                            FontSize="14"
                            BorderBrush="#B8DDE8"
                            BorderThickness="1"
                            Margin="0 0 0 14"/>

                <TextBlock Text="Телефон"
                           FontSize="14"
                           Margin="0 0 0 6"/>

                <TextBox Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}"
                         services:InputMaskBehavior.PhoneOnly="True"
                         MaxLength="20"
                         Height="38"
                         FontSize="14"
                         Padding="10 0"
                         VerticalContentAlignment="Center"
                         BorderBrush="#B8DDE8"
                         BorderThickness="1"
                         Margin="0 0 0 14"/>

                <TextBlock Text="Email"
                           FontSize="14"
                           Margin="0 0 0 6"/>

                <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"
                         Height="38"
                         FontSize="14"
                         Padding="10 0"
                         VerticalContentAlignment="Center"
                         BorderBrush="#B8DDE8"
                         BorderThickness="1"
                         Margin="0 0 0 22"/>

                <TextBlock Text="{Binding ErrorMessage}"
                           Foreground="Red"
                           FontSize="13"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           Margin="0 0 0 12"/>

                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Center">

                    <Button Content="Сохранить"
                            Width="130"
                            Height="38"
                            Margin="0 0 10 0"
                            Background="#16697A"
                            Foreground="White"
                            BorderThickness="0"
                            Cursor="Hand"
                            Command="{Binding SaveCommand}"/>

                    <Button Content="Отмена"
                            Width="130"
                            Height="38"
                            Background="#D62828"
                            Foreground="White"
                            BorderThickness="0"
                            Cursor="Hand"
                            Command="{Binding BackCommand}"/>
                </StackPanel>

            </StackPanel>
        </Border>
    </Grid>
</Page>
