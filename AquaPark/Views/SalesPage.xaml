<Page x:Class="AquaPark.Views.SalesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="SalesPage">

    <Grid Background="#EAF7FB" Margin="20">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0 0 0 20">
            <TextBlock Text="Продажи"
                       FontSize="28"
                       FontWeight="Bold"
                       Foreground="#16697A"
                       DockPanel.Dock="Left"/>

            <Button Content="Назад"
                    Width="100"
                    Height="35"
                    Background="#16697A"
                    Foreground="White"
                    BorderThickness="0"
                    Cursor="Hand"
                    HorizontalAlignment="Right"
                    Command="{Binding BackCommand}"/>
        </DockPanel>

        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    Margin="0 0 0 15">

            <Button Content="Добавить"
                    Width="110"
                    Height="36"
                    Margin="0 0 10 0"
                    Background="#16697A"
                    Foreground="White"
                    BorderThickness="0"
                    Cursor="Hand"
                    Command="{Binding AddCommand}"/>

            <Button Content="Изменить"
                    Width="110"
                    Height="36"
                    Margin="0 0 10 0"
                    Background="#16697A"
                    Foreground="White"
                    BorderThickness="0"
                    Cursor="Hand"
                    Command="{Binding EditCommand}"/>

            <Button Content="Удалить"
                    Width="110"
                    Height="36"
                    Margin="0 0 10 0"
                    Background="#D62828"
                    Foreground="White"
                    BorderThickness="0"
                    Cursor="Hand"
                    Command="{Binding DeleteCommand}"/>

            <Button Content="Обновить"
                    Width="110"
                    Height="36"
                    Margin="0 0 10 0"
                    Background="#16697A"
                    Foreground="White"
                    BorderThickness="0"
                    Cursor="Hand"
                    Command="{Binding RefreshCommand}"/>

            <TextBlock Text="Поиск:"
                       VerticalAlignment="Center"
                       FontSize="14"
                       Foreground="#333333"
                       Margin="20 0 0 0"/>

            <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                     Width="220"
                     Height="36"
                     FontSize="14"
                     Padding="10 0"
                     VerticalContentAlignment="Center"
                     BorderBrush="#B8DDE8"
                     BorderThickness="1"
                     Margin="10 0 0 0"/>
        </StackPanel>

        <DataGrid Grid.Row="2"
                  ItemsSource="{Binding Sales}"
                  SelectedItem="{Binding SelectedSale}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  Background="White"
                  BorderBrush="#B8DDE8"
                  BorderThickness="1"
                  FontSize="14">

            <DataGrid.Columns>
                <DataGridTextColumn Header="ID"
                                    Binding="{Binding SaleId}"
                                    Width="60"/>

                <DataGridTextColumn Header="Билет"
                                    Binding="{Binding Ticket.TicketId}"
                                    Width="100"/>

                <DataGridTextColumn Header="Клиент"
                                    Binding="{Binding Ticket.Client.FullName}"
                                    Width="*"/>

                <DataGridTextColumn Header="Сотрудник"
                                    Binding="{Binding Employee.User.FullName}"
                                    Width="180"/>

                <DataGridTextColumn Header="Дата продажи"
                                    Binding="{Binding SaleDate, StringFormat=dd.MM.yyyy HH:mm}"
                                    Width="160"/>

                <DataGridTextColumn Header="Сумма"
                                    Binding="{Binding TotalAmount}"
                                    Width="120"/>
            </DataGrid.Columns>
        </DataGrid>

    </Grid>
</Page>