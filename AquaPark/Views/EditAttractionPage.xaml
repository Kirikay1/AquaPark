<Page x:Class="AquaPark.Views.EditAttractionPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:services="clr-namespace:AquaPark.Services"
      Title="EditAttractionPage">

    <Grid Background="#EAF7FB">

        <Border Width="430"
                Background="White"
                CornerRadius="18"
                Padding="35"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">

            <Border.Effect>
                <DropShadowEffect BlurRadius="18"
                                  ShadowDepth="0"
                                  Opacity="0.18"/>
            </Border.Effect>

            <StackPanel>

                <TextBlock Text="Изменение аттракциона"
                           FontSize="26"
                           FontWeight="Bold"
                           Foreground="#16697A"
                           HorizontalAlignment="Center"
                           Margin="0 0 0 25"/>

                <TextBlock Text="Название"
                           FontSize="14"
                           Margin="0 0 0 6"/>

                <TextBox Text="{Binding AttractionName, UpdateSourceTrigger=PropertyChanged}"
                         Height="38"
                         FontSize="14"
                         Padding="10 0"
                         VerticalContentAlignment="Center"
                         BorderBrush="#B8DDE8"
                         BorderThickness="1"
                         Margin="0 0 0 14"/>

                <TextBlock Text="Зона"
                           FontSize="14"
                           Margin="0 0 0 6"/>

                <ComboBox ItemsSource="{Binding Zones}"
                          SelectedItem="{Binding SelectedZone}"
                          DisplayMemberPath="ZoneName"
                          Height="38"
                          FontSize="14"
                          BorderBrush="#B8DDE8"
                          BorderThickness="1"
                          Margin="0 0 0 14"/>

                <TextBlock Text="Описание"
                           FontSize="14"
                           Margin="0 0 0 6"/>

                <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                         Height="60"
                         FontSize="14"
                         Padding="10"
                         TextWrapping="Wrap"
                         AcceptsReturn="True"
                         BorderBrush="#B8DDE8"
                         BorderThickness="1"
                         Margin="0 0 0 14"/>

                <TextBlock Text="Возрастное ограничение"
                           FontSize="14"
                           Margin="0 0 0 6"/>

                <TextBox Text="{Binding AgeLimit, UpdateSourceTrigger=PropertyChanged}"
                         services:InputMaskBehavior.NumericOnly="True"
                         MaxLength="3"
                         Height="38"
                         FontSize="14"
                         Padding="10 0"
                         VerticalContentAlignment="Center"
                         BorderBrush="#B8DDE8"
                         BorderThickness="1"
                         Margin="0 0 0 14"/>

                <TextBlock Text="Ограничение по росту"
                           FontSize="14"
                           Margin="0 0 0 6"/>

                <TextBox Text="{Binding HeightLimit, UpdateSourceTrigger=PropertyChanged}"
                         services:InputMaskBehavior.NumericOnly="True"
                         MaxLength="3"
                         Height="38"
                         FontSize="14"
                         Padding="10 0"
                         VerticalContentAlignment="Center"
                         BorderBrush="#B8DDE8"
                         BorderThickness="1"
                         Margin="0 0 0 14"/>

                <CheckBox Content="Аттракцион активен"
                          IsChecked="{Binding IsActive}"
                          FontSize="14"
                          Margin="0 0 0 18"/>

                <TextBlock Text="{Binding ErrorMessage}"
                           Foreground="Red"
                           FontSize="13"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           Margin="0 0 0 12"/>

                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Center">

                    <Button Content="Сохранить"
                            Width="130"
                            Height="38"
                            Margin="0 0 10 0"
                            Background="#16697A"
                            Foreground="White"
                            BorderThickness="0"
                            Cursor="Hand"
                            Command="{Binding SaveCommand}"/>

                    <Button Content="Отмена"
                            Width="130"
                            Height="38"
                            Background="#D62828"
                            Foreground="White"
                            BorderThickness="0"
                            Cursor="Hand"
                            Command="{Binding BackCommand}"/>
                </StackPanel>

            </StackPanel>
        </Border>
    </Grid>
</Page>
