<Page x:Class="AquaPark.Views.ReportsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="ReportsPage">

    <Grid Background="#EAF7FB" Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0 0 0 20">
            <TextBlock Text="Отчеты"
                       FontSize="28"
                       FontWeight="Bold"
                       Foreground="#16697A"
                       DockPanel.Dock="Left"/>

            <Button Content="Назад"
                    Style="{StaticResource MainButtonStyle}"
                    Width="100"
                    HorizontalAlignment="Right"
                    Command="{Binding BackCommand}"/>
        </DockPanel>

        <StackPanel Grid.Row="1" Margin="0 0 0 15">
            <WrapPanel>
                <TextBlock Text="Период с:"
                           VerticalAlignment="Center"
                           FontSize="14"
                           Foreground="#333333"
                           Margin="0 0 10 8"/>

                <DatePicker SelectedDate="{Binding DateFrom}"
                            Width="145"
                            Margin="0 0 10 8"/>

                <TextBlock Text="по:"
                           VerticalAlignment="Center"
                           FontSize="14"
                           Foreground="#333333"
                           Margin="0 0 10 8"/>

                <DatePicker SelectedDate="{Binding DateTo}"
                            Width="145"
                            Margin="0 0 10 8"/>

                <Button Content="Обновить"
                        Style="{StaticResource MainButtonStyle}"
                        Width="110"
                        Command="{Binding RefreshCommand}"/>

                <Button Content="Экспорт CSV"
                        Style="{StaticResource MainButtonStyle}"
                        Width="130"
                        Command="{Binding ExportCommand}"/>
            </WrapPanel>

            <TextBlock Text="{Binding ErrorMessage}"
                       Foreground="Red"
                       FontSize="13"
                       TextWrapping="Wrap"
                       Margin="0 0 0 10"/>

            <UniformGrid Columns="4">
                <Border Background="White" CornerRadius="10" Padding="15" Margin="0 0 10 0">
                    <StackPanel>
                        <TextBlock Text="Продажи" Foreground="#444444"/>
                        <TextBlock Text="{Binding SalesCount}" FontSize="24" FontWeight="Bold" Foreground="#16697A"/>
                    </StackPanel>
                </Border>

                <Border Background="White" CornerRadius="10" Padding="15" Margin="0 0 10 0">
                    <StackPanel>
                        <TextBlock Text="Билеты" Foreground="#444444"/>
                        <TextBlock Text="{Binding TicketsCount}" FontSize="24" FontWeight="Bold" Foreground="#16697A"/>
                    </StackPanel>
                </Border>

                <Border Background="White" CornerRadius="10" Padding="15" Margin="0 0 10 0">
                    <StackPanel>
                        <TextBlock Text="Сумма продаж" Foreground="#444444"/>
                        <TextBlock Text="{Binding SalesTotalAmount, StringFormat={}{0:N2} руб.}" FontSize="24" FontWeight="Bold" Foreground="#16697A"/>
                    </StackPanel>
                </Border>

                <Border Background="White" CornerRadius="10" Padding="15">
                    <StackPanel>
                        <TextBlock Text="Сумма оплат" Foreground="#444444"/>
                        <TextBlock Text="{Binding PaymentsTotalAmount, StringFormat={}{0:N2} руб.}" FontSize="24" FontWeight="Bold" Foreground="#16697A"/>
                    </StackPanel>
                </Border>
            </UniformGrid>
        </StackPanel>

        <TabControl Grid.Row="2">
            <TabItem Header="Продажи">
                <DataGrid ItemsSource="{Binding Sales}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID" Binding="{Binding SaleId}" Width="60"/>
                        <DataGridTextColumn Header="Дата" Binding="{Binding SaleDate, StringFormat=dd.MM.yyyy HH:mm}" Width="160"/>
                        <DataGridTextColumn Header="Билет" Binding="{Binding TicketId}" Width="100"/>
                        <DataGridTextColumn Header="Клиент" Binding="{Binding Ticket.Client.FullName}" Width="*"/>
                        <DataGridTextColumn Header="Сотрудник" Binding="{Binding Employee.User.FullName}" Width="180"/>
                        <DataGridTextColumn Header="Сумма" Binding="{Binding TotalAmount}" Width="120"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <TabItem Header="Оплаты">
                <DataGrid ItemsSource="{Binding Payments}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID" Binding="{Binding PaymentId}" Width="60"/>
                        <DataGridTextColumn Header="Дата" Binding="{Binding PaymentDate, StringFormat=dd.MM.yyyy HH:mm}" Width="160"/>
                        <DataGridTextColumn Header="Продажа" Binding="{Binding SaleId}" Width="100"/>
                        <DataGridTextColumn Header="Клиент" Binding="{Binding Sale.Ticket.Client.FullName}" Width="*"/>
                        <DataGridTextColumn Header="Способ" Binding="{Binding PaymentMethod}" Width="150"/>
                        <DataGridTextColumn Header="Статус" Binding="{Binding PaymentStatus}" Width="130"/>
                        <DataGridTextColumn Header="Сумма" Binding="{Binding Amount}" Width="120"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
        </TabControl>
    </Grid>
</Page>
