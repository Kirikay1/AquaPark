<Page x:Class="AquaPark.Views.AttractionSchedulesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="AttractionSchedulesPage">

    <Grid Background="#EAF7FB" Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0 0 0 20">
            <TextBlock Text="Расписание аттракционов"
                       FontSize="28"
                       FontWeight="Bold"
                       Foreground="#16697A"
                       DockPanel.Dock="Left"/>

            <Button Content="Назад"
                    Style="{StaticResource MainButtonStyle}"
                    Width="100"
                    HorizontalAlignment="Right"
                    Command="{Binding BackCommand}"/>
        </DockPanel>

        <WrapPanel Grid.Row="1" Margin="0 0 0 15">
            <Button Content="Добавить"
                    Style="{StaticResource MainButtonStyle}"
                    Width="110"
                    Command="{Binding AddCommand}"
                    Visibility="{Binding AddButtonVisibility}"/>

            <Button Content="Изменить"
                    Style="{StaticResource MainButtonStyle}"
                    Width="110"
                    Command="{Binding EditCommand}"
                    Visibility="{Binding EditButtonVisibility}"/>

            <Button Content="Удалить"
                    Style="{StaticResource MainButtonStyle}"
                    Width="110"
                    Background="#D62828"
                    Command="{Binding DeleteCommand}"
                    Visibility="{Binding DeleteButtonVisibility}"/>

            <Button Content="Обновить"
                    Style="{StaticResource MainButtonStyle}"
                    Width="110"
                    Command="{Binding RefreshCommand}"/>

            <TextBlock Text="Дата:"
                       VerticalAlignment="Center"
                       FontSize="14"
                       Foreground="#333333"
                       Margin="20 0 10 8"/>

            <DatePicker SelectedDate="{Binding FilterDate}"
                        Width="145"
                        Margin="0 0 10 8"/>

            <TextBlock Text="Статус:"
                       VerticalAlignment="Center"
                       FontSize="14"
                       Foreground="#333333"
                       Margin="10 0 10 8"/>

            <ComboBox ItemsSource="{Binding Statuses}"
                      SelectedItem="{Binding SelectedStatus}"
                      Width="150"
                      Margin="0 0 10 8"/>

            <Button Content="Сбросить"
                    Style="{StaticResource MainButtonStyle}"
                    Width="110"
                    Command="{Binding ClearFiltersCommand}"/>
        </WrapPanel>

        <DataGrid Grid.Row="2"
                  ItemsSource="{Binding Schedules}"
                  SelectedItem="{Binding SelectedSchedule}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding ScheduleId}" Width="60"/>
                <DataGridTextColumn Header="Дата" Binding="{Binding WorkDate, StringFormat=dd.MM.yyyy}" Width="120"/>
                <DataGridTextColumn Header="Аттракцион" Binding="{Binding Attraction.AttractionName}" Width="*"/>
                <DataGridTextColumn Header="Зона" Binding="{Binding Attraction.Zone.ZoneName}" Width="160"/>
                <DataGridTextColumn Header="Начало" Binding="{Binding StartTime}" Width="100"/>
                <DataGridTextColumn Header="Окончание" Binding="{Binding EndTime}" Width="110"/>
                <DataGridTextColumn Header="Статус" Binding="{Binding Status}" Width="130"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0 12 0 0">
            <Button Content="|&lt;" Width="45" Height="32" Margin="0 0 8 0" Command="{Binding FirstPageCommand}"/>
            <Button Content="&lt;" Width="45" Height="32" Margin="0 0 12 0" Command="{Binding PreviousPageCommand}"/>
            <TextBlock Text="{Binding PageInfo}" VerticalAlignment="Center" FontSize="14" Foreground="#333333"/>
            <Button Content="&gt;" Width="45" Height="32" Margin="12 0 8 0" Command="{Binding NextPageCommand}"/>
            <Button Content="&gt;|" Width="45" Height="32" Command="{Binding LastPageCommand}"/>
        </StackPanel>    </Grid>
</Page>
