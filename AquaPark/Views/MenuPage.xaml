<Page x:Class="AquaPark.Views.MenuPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="MenuPage">

    <Grid Background="#EAF7FB">

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Background="#16697A"
                Padding="20">

            <StackPanel>

                <TextBlock Text="АРМ Аквапарка"
                           Foreground="White"
                           FontSize="22"
                           FontWeight="Bold"
                           TextWrapping="Wrap"
                           Margin="0 0 0 30"/>

                <Border Background="#125664"
                        CornerRadius="10"
                        Padding="10"
                        Margin="0 0 0 25">

                    <StackPanel>
                        <TextBlock Text="{Binding CurrentUserName}"
                           Foreground="White"
                           FontSize="14"
                           FontWeight="SemiBold"
                           TextWrapping="Wrap"/>

                        <TextBlock Text="{Binding CurrentUserRole}"
                           Foreground="#D8F3F8"
                           FontSize="12"
                           Margin="0 5 0 0"
                           TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <Button Content="Клиенты"
                        Height="42"
                        Margin="0 0 0 10"
                        FontSize="14"
                        Background="White"
                        Foreground="#16697A"
                        BorderThickness="0"
                        Cursor="Hand"
                        Command="{Binding ClientsCommand}"
                        Visibility="{Binding ClientsVisibility}"/>

                <Button Content="Билеты"
                        Height="42"
                        Margin="0 0 0 10"
                        FontSize="14"
                        Background="White"
                        Foreground="#16697A"
                        BorderThickness="0"
                        Cursor="Hand"
                        Command="{Binding TicketsCommand}"
                        Visibility="{Binding TicketsVisibility}"/>

                <Button Content="Аттракционы"
                        Height="42"
                        Margin="0 0 0 10"
                        FontSize="14"
                        Background="White"
                        Foreground="#16697A"
                        BorderThickness="0"
                        Cursor="Hand"
                        Command="{Binding AttractionsCommand}"
                        Visibility="{Binding AttractionsVisibility}"/>

                <Button Content="Продажи"
                        Height="42"
                        Margin="0 0 0 10"
                        FontSize="14"
                        Background="White"
                        Foreground="#16697A"
                        BorderThickness="0"
                        Cursor="Hand"
                        Command="{Binding SalesCommand}"
                        Visibility="{Binding SalesVisibility}"/>

                <Button Content="Оплаты"
                        Height="42"
                        Margin="0 0 0 10"
                        FontSize="14"
                        Background="White"
                        Foreground="#16697A"
                        BorderThickness="0"
                        Cursor="Hand"
                        Command="{Binding PaymentsCommand}"
                        Visibility="{Binding PaymentsVisibility}"/>

                <Button Content="Выход"
                        Height="42"
                        Margin="0 30 0 0"
                        FontSize="14"
                        Background="#D62828"
                        Foreground="White"
                        BorderThickness="0"
                        Cursor="Hand"
                        Command="{Binding LogoutCommand}"/>

            </StackPanel>
        </Border>

        <Grid Grid.Column="1"
              Margin="30">

            <Border Background="White"
                    CornerRadius="18"
                    Padding="30">

                <Border.Effect>
                    <DropShadowEffect BlurRadius="18"
                                      ShadowDepth="0"
                                      Opacity="0.18"/>
                </Border.Effect>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="300"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0"
                                Margin="0 0 25 0">

                        <TextBlock Text="Главное меню"
                                   FontSize="28"
                                   FontWeight="Bold"
                                   Foreground="#16697A"
                                   Margin="0 0 0 15"/>

                        <TextBlock Text="Добро пожаловать в автоматизированное рабочее место аквапарка."
                                   FontSize="16"
                                   Foreground="#333333"
                                   TextWrapping="Wrap"
                                   Margin="0 0 0 30"/>

                        <UniformGrid Columns="2"
                                     Rows="2">

                            <Border Background="#F2FBFD"
                                    CornerRadius="14"
                                    Padding="20"
                                    Margin="0 0 15 15">
                                <StackPanel>
                                    <TextBlock Text="Клиенты"
                                               FontSize="20"
                                               FontWeight="SemiBold"
                                               Foreground="#16697A"/>
                                    <TextBlock Text="Учет посетителей аквапарка"
                                               FontSize="14"
                                               Foreground="#444444"
                                               Margin="0 8 0 0"/>
                                </StackPanel>
                            </Border>

                            <Border Background="#F2FBFD"
                                    CornerRadius="14"
                                    Padding="20"
                                    Margin="0 0 0 15">
                                <StackPanel>
                                    <TextBlock Text="Билеты"
                                               FontSize="20"
                                               FontWeight="SemiBold"
                                               Foreground="#16697A"/>
                                    <TextBlock Text="Продажа и проверка билетов"
                                               FontSize="14"
                                               Foreground="#444444"
                                               Margin="0 8 0 0"/>
                                </StackPanel>
                            </Border>

                            <Border Background="#F2FBFD"
                                    CornerRadius="14"
                                    Padding="20"
                                    Margin="0 0 15 0">
                                <StackPanel>
                                    <TextBlock Text="Аттракционы"
                                               FontSize="20"
                                               FontWeight="SemiBold"
                                               Foreground="#16697A"/>
                                    <TextBlock Text="Управление зонами и расписанием"
                                               FontSize="14"
                                               Foreground="#444444"
                                               Margin="0 8 0 0"/>
                                </StackPanel>
                            </Border>

                            <Border Background="#F2FBFD"
                                    CornerRadius="14"
                                    Padding="20">
                                <StackPanel>
                                    <TextBlock Text="Продажи"
                                               FontSize="20"
                                               FontWeight="SemiBold"
                                               Foreground="#16697A"/>
                                    <TextBlock Text="Контроль продаж и оплат"
                                               FontSize="14"
                                               Foreground="#444444"
                                               Margin="0 8 0 0"/>
                                </StackPanel>
                            </Border>

                        </UniformGrid>

                    </StackPanel>

                    <StackPanel Grid.Column="1">

                        <TextBlock Text="Статистика"
                                   FontSize="24"
                                   FontWeight="Bold"
                                   Foreground="#16697A"
                                   Margin="0 0 0 15"/>

                        <Border Background="#F2FBFD"
                                CornerRadius="14"
                                Padding="18"
                                Margin="0 0 0 12">
                            <StackPanel>
                                <TextBlock Text="Клиенты"
                                           FontSize="14"
                                           Foreground="#444444"/>
                                <TextBlock Text="{Binding ClientsCount}"
                                           FontSize="30"
                                           FontWeight="Bold"
                                           Foreground="#16697A"
                                           Margin="0 4 0 0"/>
                            </StackPanel>
                        </Border>

                        <Border Background="#F2FBFD"
                                CornerRadius="14"
                                Padding="18"
                                Margin="0 0 0 12">
                            <StackPanel>
                                <TextBlock Text="Билеты"
                                           FontSize="14"
                                           Foreground="#444444"/>
                                <TextBlock Text="{Binding TicketsCount}"
                                           FontSize="30"
                                           FontWeight="Bold"
                                           Foreground="#16697A"
                                           Margin="0 4 0 0"/>
                            </StackPanel>
                        </Border>

                        <Border Background="#F2FBFD"
                                CornerRadius="14"
                                Padding="18"
                                Margin="0 0 0 12">
                            <StackPanel>
                                <TextBlock Text="Продажи"
                                           FontSize="14"
                                           Foreground="#444444"/>
                                <TextBlock Text="{Binding SalesCount}"
                                           FontSize="30"
                                           FontWeight="Bold"
                                           Foreground="#16697A"
                                           Margin="0 4 0 0"/>
                            </StackPanel>
                        </Border>

                        <Border Background="#E0F5FA"
                                CornerRadius="14"
                                Padding="18">
                            <StackPanel>
                                <TextBlock Text="Сумма оплат"
                                           FontSize="14"
                                           Foreground="#444444"/>
                                <TextBlock Text="{Binding PaymentsTotalAmount, StringFormat={}{0:N2} руб.}"
                                           FontSize="26"
                                           FontWeight="Bold"
                                           Foreground="#16697A"
                                           Margin="0 4 0 0"/>
                            </StackPanel>
                        </Border>

                    </StackPanel>

                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
