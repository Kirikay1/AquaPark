<Page x:Class="AquaPark.Views.MenuPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="MenuPage">

    <Grid Background="#EAF7FB">

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Background="#16697A"
                Padding="20">

            <StackPanel>

                <TextBlock Text="АРМ Аквапарка"
                           Foreground="White"
                           FontSize="22"
                           FontWeight="Bold"
                           TextWrapping="Wrap"
                           Margin="0 0 0 30"/>

                <Button Content="Клиенты"
                        Height="42"
                        Margin="0 0 0 10"
                        FontSize="14"
                        Background="White"
                        Foreground="#16697A"
                        BorderThickness="0"
                        Cursor="Hand"
                        Command="{Binding ClientsCommand}"/>

                <Button Content="Билеты"
                        Height="42"
                        Margin="0 0 0 10"
                        FontSize="14"
                        Background="White"
                        Foreground="#16697A"
                        BorderThickness="0"
                        Cursor="Hand"
                        Command="{Binding TicketsCommand}"/>

                <Button Content="Аттракционы"
                        Height="42"
                        Margin="0 0 0 10"
                        FontSize="14"
                        Background="White"
                        Foreground="#16697A"
                        BorderThickness="0"
                        Cursor="Hand"
                        Command="{Binding AttractionsCommand}"/>

                <Button Content="Продажи"
                        Height="42"
                        Margin="0 0 0 10"
                        FontSize="14"
                        Background="White"
                        Foreground="#16697A"
                        BorderThickness="0"
                        Cursor="Hand"/>

                <Button Content="Оплаты"
                        Height="42"
                        Margin="0 0 0 10"
                        FontSize="14"
                        Background="White"
                        Foreground="#16697A"
                        BorderThickness="0"
                        Cursor="Hand"/>

                <Button Content="Выход"
                        Height="42"
                        Margin="0 30 0 0"
                        FontSize="14"
                        Background="#D62828"
                        Foreground="White"
                        BorderThickness="0"
                        Cursor="Hand"/>

            </StackPanel>
        </Border>

        <Grid Grid.Column="1"
              Margin="30">

            <Border Background="White"
                    CornerRadius="18"
                    Padding="30">

                <Border.Effect>
                    <DropShadowEffect BlurRadius="18"
                                      ShadowDepth="0"
                                      Opacity="0.18"/>
                </Border.Effect>

                <StackPanel>

                    <TextBlock Text="Главное меню"
                               FontSize="28"
                               FontWeight="Bold"
                               Foreground="#16697A"
                               Margin="0 0 0 15"/>

                    <TextBlock Text="Добро пожаловать в автоматизированное рабочее место аквапарка."
                               FontSize="16"
                               Foreground="#333333"
                               TextWrapping="Wrap"
                               Margin="0 0 0 30"/>

                    <UniformGrid Columns="2"
                                 Rows="2">

                        <Border Background="#F2FBFD"
                                CornerRadius="14"
                                Padding="20"
                                Margin="0 0 15 15">
                            <StackPanel>
                                <TextBlock Text="Клиенты"
                                           FontSize="20"
                                           FontWeight="SemiBold"
                                           Foreground="#16697A"/>
                                <TextBlock Text="Учет посетителей аквапарка"
                                           FontSize="14"
                                           Foreground="#444444"
                                           Margin="0 8 0 0"/>
                            </StackPanel>
                        </Border>

                        <Border Background="#F2FBFD"
                                CornerRadius="14"
                                Padding="20"
                                Margin="0 0 0 15">
                            <StackPanel>
                                <TextBlock Text="Билеты"
                                           FontSize="20"
                                           FontWeight="SemiBold"
                                           Foreground="#16697A"/>
                                <TextBlock Text="Продажа и проверка билетов"
                                           FontSize="14"
                                           Foreground="#444444"
                                           Margin="0 8 0 0"/>
                            </StackPanel>
                        </Border>

                        <Border Background="#F2FBFD"
                                CornerRadius="14"
                                Padding="20"
                                Margin="0 0 15 0">
                            <StackPanel>
                                <TextBlock Text="Аттракционы"
                                           FontSize="20"
                                           FontWeight="SemiBold"
                                           Foreground="#16697A"/>
                                <TextBlock Text="Управление зонами и расписанием"
                                           FontSize="14"
                                           Foreground="#444444"
                                           Margin="0 8 0 0"/>
                            </StackPanel>
                        </Border>

                        <Border Background="#F2FBFD"
                                CornerRadius="14"
                                Padding="20">
                            <StackPanel>
                                <TextBlock Text="Продажи"
                                           FontSize="20"
                                           FontWeight="SemiBold"
                                           Foreground="#16697A"/>
                                <TextBlock Text="Контроль продаж и оплат"
                                           FontSize="14"
                                           Foreground="#444444"
                                           Margin="0 8 0 0"/>
                            </StackPanel>
                        </Border>

                    </UniformGrid>

                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Page>