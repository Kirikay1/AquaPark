<Page x:Class="AquaPark.Views.PaymentsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="PaymentsPage">

    <Grid Background="#EAF7FB" Margin="20">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0 0 0 20">
            <TextBlock Text="Оплаты"
                       FontSize="28"
                       FontWeight="Bold"
                       Foreground="#16697A"
                       DockPanel.Dock="Left"/>

            <Button Content="Назад"
                    Width="100"
                    Height="35"
                    Background="#16697A"
                    Foreground="White"
                    BorderThickness="0"
                    Cursor="Hand"
                    HorizontalAlignment="Right"
                    Command="{Binding BackCommand}"/>
        </DockPanel>

        <WrapPanel Grid.Row="1"
                   Orientation="Horizontal"
                   Margin="0 0 0 15">

            <Button Content="Добавить"
                    Width="110"
                    Height="36"
                    Margin="0 0 10 0"
                    Background="#16697A"
                    Foreground="White"
                    BorderThickness="0"
                    Cursor="Hand"
                    Command="{Binding AddCommand}"
                    Visibility="{Binding AddButtonVisibility}"/>

            <Button Content="Изменить"
                    Width="110"
                    Height="36"
                    Margin="0 0 10 0"
                    Background="#16697A"
                    Foreground="White"
                    BorderThickness="0"
                    Cursor="Hand"
                    Command="{Binding EditCommand}"
                    Visibility="{Binding EditButtonVisibility}"/>

            <Button Content="Удалить"
                    Width="110"
                    Height="36"
                    Margin="0 0 10 0"
                    Background="#D62828"
                    Foreground="White"
                    BorderThickness="0"
                    Cursor="Hand"
                    Command="{Binding DeleteCommand}"
                    Visibility="{Binding DeleteButtonVisibility}"/>

            <Button Content="Обновить"
                    Width="110"
                    Height="36"
                    Margin="0 0 10 0"
                    Background="#16697A"
                    Foreground="White"
                    BorderThickness="0"
                    Cursor="Hand"
                    Command="{Binding RefreshCommand}"/>

            <TextBlock Text="Поиск:"
                       VerticalAlignment="Center"
                       FontSize="14"
                       Foreground="#333333"
                       Margin="20 0 0 0"/>

            <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                     Width="220"
                     Height="36"
                     FontSize="14"
                     Padding="10 0"
                     VerticalContentAlignment="Center"
                     BorderBrush="#B8DDE8"
                     BorderThickness="1"
                     Margin="10 0 0 0"/>

            <Button Content="Очистить"
                    Width="110"
                    Height="36"
                    Margin="10 0 0 0"
                    Background="#16697A"
                    Foreground="White"
                    BorderThickness="0"
                    Cursor="Hand"
                    Command="{Binding ClearSearchCommand}"/>
        </WrapPanel>

        <DataGrid Grid.Row="2"
                  ItemsSource="{Binding Payments}"
                  SelectedItem="{Binding SelectedPayment}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  Background="White"
                  BorderBrush="#B8DDE8"
                  BorderThickness="1"
                  FontSize="14">

            <DataGrid.Columns>
                <DataGridTextColumn Header="ID"
                                    Binding="{Binding PaymentId}"
                                    Width="60"/>

                <DataGridTextColumn Header="Продажа"
                                    Binding="{Binding Sale.SaleId}"
                                    Width="100"/>

                <DataGridTextColumn Header="Клиент"
                                    Binding="{Binding Sale.Ticket.Client.FullName}"
                                    Width="*"/>

                <DataGridTextColumn Header="Дата оплаты"
                                    Binding="{Binding PaymentDate, StringFormat=dd.MM.yyyy HH:mm}"
                                    Width="160"/>

                <DataGridTextColumn Header="Сумма"
                                    Binding="{Binding Amount}"
                                    Width="120"/>

                <DataGridTextColumn Header="Способ оплаты"
                                    Binding="{Binding PaymentMethod}"
                                    Width="150"/>

                <DataGridTextColumn Header="Статус"
                                    Binding="{Binding PaymentStatus}"
                                    Width="130"/>
            </DataGrid.Columns>
        </DataGrid>

    </Grid>
</Page>
